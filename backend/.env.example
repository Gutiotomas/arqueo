# Copia este fichero a .env y ajusta los valores.

# --- Base de datos -------------------------------------------------------
# Local (PostgreSQL de Homebrew, arrancado con ./db.sh start):
DATABASE_URL="postgresql://arqueo:arqueo@localhost:5432/arqueo?schema=public"
# En produccion: pega aqui el POSTGRESQL_ADDON_URI del addon de Clever Cloud.

# --- API -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT. En produccion usa un valor largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-en-produccion-por-un-secreto-largo-y-aleatorio"
# Duracion de la sesion. Con 12h, quien entra cada manana vuelve a pasar por
# el login: asi la espera de que Render despierte el servidor ocurre ahi y no
# a mitad de registrar una venta.
JWT_EXPIRES_IN="12h"

# Origenes permitidos por CORS, separados por comas.
# En produccion: https://tu-app.vercel.app
CORS_ORIGIN="http://localhost:5173"

# --- Datos de demostracion ------------------------------------------------
# Si es true, `npm run seed` crea la empresa demo con 60 dias de movimientos.
SEED_DEMO=true
SEED_EMAIL="demo@arqueo.app"
SEED_PASSWORD="demo1234"
