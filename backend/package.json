{
  "name": "arqueo-backend",
  "version": "0.1.0",
  "description": "API de Arqueo: ventas, gastos e inventario para pequenos negocios",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsc -p tsconfig.seed.json && node dist/seed/prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "test:cov": "vitest run --coverage",
    "start:deploy": "prisma migrate deploy && node dist/main.js"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/bcrypt": "6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.11.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "^7.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.5"
  }
}
